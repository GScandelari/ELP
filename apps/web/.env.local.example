# Copie para .env.local e ajuste.
#
# Desenvolvimento local com o Firebase Emulator Suite:
#   - use um projectId com prefixo "demo-" (não precisa de projeto real nem billing)
#   - NEXT_PUBLIC_USE_EMULATORS=true faz o app apontar para os emuladores
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-elp
NEXT_PUBLIC_FIREBASE_API_KEY=demo
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-elp.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-elp.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=0
NEXT_PUBLIC_FIREBASE_APP_ID=demo

# Para apontar ao projeto real elp-dev, troque USE_EMULATORS para false e
# preencha os valores de Configurações do projeto > Seus apps > Config do SDK.
